# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Spotify Developer Configuration
# Get these from Spotify Developer Dashboard: https://developer.spotify.com/dashboard
VITE_SPOTIFY_CLIENT_ID=your-spotify-client-id
VITE_SPOTIFY_REDIRECT_URI=http://localhost:5173/callback

# Emulator Configuration (Optional - uses CDN defaults)
VITE_RETROARCH_CDN=https://cdn.jsdelivr.net/npm/@retroarch/web@latest/dist/
VITE_CORES_CDN=https://cdn.jsdelivr.net/npm/@retroarch/web@latest/dist/cores/

# Feature Flags
VITE_ENABLE_NETPLAY=false
VITE_ENABLE_ACHIEVEMENTS=false